# ESXi host passwords — copy this file to .env and fill in your values.
# The .env file is gitignored and never committed.
# Variable name format: ESXI_{HOSTNAME_UPPERCASE_UNDERSCORED}_PASSWORD

ESXI_ESX_01_PASSWORD=your_root_password_here
ESXI_ESX_02_PASSWORD=your_root_password_here

# Optional: override config file location
# ESXI_MCP_CONFIG=./config/hosts.yaml
